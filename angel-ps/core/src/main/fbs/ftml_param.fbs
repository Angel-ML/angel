include "grad_message.fbs";
include "training_message.fbs";

namespace dollar.tensor.ftml;

table HyperParam {
  alpha:double (id:0);
  beta1:double (id:1);
  beta2:double (id:2);
  lambda1:double (id:3);
  lambda2:double (id:4);
  epsilon:double (id:5);
  grad_factor:double (id:6);
}

table WeightParams {
  z:[ubyte] (id:0);
  v:[ubyte] (id:1);
  d:[ubyte] (id:2);
  g:[ubyte] (id:3);
}

table FtmlGradMessage {
  hyper_param:HyperParam (id:0);
  grad_message:GradMessage (id:1);
  training_message:TrainingMessage (id:2);
  init_flag:int8 (id:3);
}

table FtmlWeightParams {
  weight_params:WeightParams (id:0);
  field:int32 (id:1);
  positive_count:int64 (id:2);
  negative_count:int64 (id:3);
  update_times:int64 (id:4);
  training_message:TrainingMessage (id:5);
}
