include "stats_param.fbs";

//namespace tair.optimizers;
namespace dollar.tensor;

table GradMessage {
  grads:[float] (id:0);
  field:int32 (id:1);
  positive_count:int32 (id:2);
  negative_count:int32 (id:3);
  task_stats:TaskStats (id:4);
  g_grads:GeneralGrads (id:5);
}

table ByteGradMessage {
  grads:[byte] (id:0);
  field:int32 (id:1);
  positive_count:int32 (id:2);
  negative_count:int32 (id:3);
  task_stats:TaskStats (id:4);
}

union MpqGradMessage {
  float_message: GradMessage,
  byte_message: ByteGradMessage,
}

// grads_type : how many bits in one quantized block
table GeneralGrads {
  grads_type:int8 (id:0);
  grads:[ubyte] (id:1);
}
